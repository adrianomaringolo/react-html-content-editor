{
  "name": "react-html-content-editor",
  "version": "1.3.0",
  "description": "A sophisticated HTML and CSS content editor with multiple view modes, auto-save and optional Monaco Editor integration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./monaco": {
      "types": "./dist/monaco.d.ts",
      "import": "./dist/monaco.mjs",
      "require": "./dist/monaco.cjs"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "html-editor",
    "css-editor",
    "monaco-editor",
    "content-editor",
    "code-editor",
    "wysiwyg",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianomaringolo/react-html-content-editor.git",
    "directory": "packages/library"
  },
  "homepage": "https://adrianomaringolo.github.io/react-html-content-editor/",
  "bugs": {
    "url": "https://github.com/adrianomaringolo/react-html-content-editor/issues"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@monaco-editor/react": {
      "optional": true
    },
    "monaco-editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "terser": "^5.49.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  }
}
